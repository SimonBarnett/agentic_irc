# PROPOSED replacement for .github/workflows/airc-console-release.yml (issue #305).
# Copy over the live workflow after merge if the bot token lacks `workflow` scope.
# ---
name: airc-console-release
on:
  push:
    branches: [main]
    paths:
      - "scripts/airc_console.py"
      - "scripts/airc_console_service.py"
      - "scripts/Start-AircConsole.ps1"
      - "scripts/Start-AircConsole.cmd"
      - "scripts/Install-AircConsole.ps1"
      - "scripts/Install-AircConsole.cmd"
      - "scripts/Resolve-AircConsoleNssm.ps1"
      - "scripts/Resolve-AircConsolePython.ps1"
      - "scripts/Fetch-Nssm.ps1"
      - "scripts/Fetch-Wix.ps1"
      - "scripts/Pack-AircConsoleRelease.ps1"
      - "packaging/airc-console/**"
      - "src/airc_console/**"
      - "docs/airc-console-fr253.md"
      - ".github/workflows/airc-console-release.yml"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  release:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Offline tests
        run: python -m pytest tests/test_airc_console_fr253.py -q
      - name: Pack MSI
        shell: pwsh
        env:
          # Issue #294: embed Ergo PASS into MSI (clients have no ~/.grok).
          AIRC_PACK_ERGO_PASSWORD: ${{ secrets.AIRC_PACK_ERGO_PASSWORD || secrets.AGENTIC_IRC_PASSWORD }}
          AGENTIC_IRC_PASSWORD: ${{ secrets.AGENTIC_IRC_PASSWORD }}
        run: |
          if (-not $env:AIRC_PACK_ERGO_PASSWORD -and -not $env:AGENTIC_IRC_PASSWORD) {
            Write-Error 'Missing GitHub secret AIRC_PACK_ERGO_PASSWORD or AGENTIC_IRC_PASSWORD for config/ergo.password (issue #294)'
          }
          powershell -NoProfile -ExecutionPolicy Bypass -File scripts\Pack-AircConsoleRelease.ps1 -KeepStage
          Get-ChildItem dist | Format-Table Name, Length
          $msi = Get-ChildItem dist/airc-console-*.msi | Select-Object -First 1
          if (-not $msi) { Write-Error 'pack did not produce MSI (issue #305)' }
          # Confirm secret file is inside staged tree that was harvested into the MSI
          $stage = Get-ChildItem dist -Directory -Filter 'airc-console-*' | Select-Object -First 1
          if (-not $stage -or -not (Test-Path (Join-Path $stage.FullName 'config\ergo.password'))) {
            Write-Error 'stage missing config/ergo.password before MSI harvest'
          }
          Write-Host "INFO MSI $($msi.Name) len=$($msi.Length)"
      - name: Rolling release airc-console
        uses: softprops/action-gh-release@v2
        with:
          tag_name: airc-console
          name: airc-console
          target_commitish: ${{ github.sha }}
          body: |
            Rolling airc console service (FR #253 / #305).

            Single **MSI** install (per-machine, UAC). Nick `console-<machine>` on `#{machine}`,
            silent in channel, auth PRIVMSG â†’ shell. Bundled NSSM. See `docs/airc-console-fr253.md`.
          files: |
            dist/airc-console-*.msi
            dist/airc-console-*.msi.sha256
          make_latest: false
      - name: Immutable version tag if new
        env:
          GH_TOKEN: ${{ github.token }}
        shell: pwsh
        run: |
          $ver = (Get-Content src/airc_console/VERSION -Raw).Trim()
          $tag = "airc-console-v$ver"
          git fetch --tags --force
          $exists = git tag -l $tag
          if ($exists) {
            Write-Host "tag $tag already exists; leaving immutable"
            exit 0
          }
          $msi = Get-ChildItem dist/airc-console-$ver.msi | Select-Object -First 1
          $sha = Get-ChildItem dist/airc-console-$ver.msi.sha256 | Select-Object -First 1
          gh release create $tag $msi.FullName $sha.FullName `
            --title $tag `
            --notes "airc console $ver (FR #253 / #305). Single MSI. See docs/airc-console-fr253.md." `
            --target ${{ github.sha }}
